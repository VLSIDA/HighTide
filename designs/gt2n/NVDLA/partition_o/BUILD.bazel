load("//:defs.bzl", "hightide_design")

hightide_design(
    name = "partition_o",
    top = "NV_NVDLA_partition_o",
    platform = "gt2n",
    verilog_files = ["//designs/src/NVDLA:rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": ["//designs/gt2n/NVDLA:sram_lefs_o"],
        "ADDITIONAL_LIBS": ["//designs/gt2n/NVDLA:sram_libs_o"],
        "PRE_CTS_TCL": [":pre_cts.tcl"],
    },
    stage_data = {"synth": ["//designs/src/NVDLA:include"]},
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "VERILOG_INCLUDE_DIRS": "bazel-out/k8-fastbuild/bin/designs/src/NVDLA/vmod/include bazel-out/k8-fastbuild/bin/designs/src/NVDLA/vmod/vlibs",
        "CORE_UTILIZATION": "46",
        "MAX_ROUTING_LAYER": "M11",
        "MIN_CLK_ROUTING_LAYER": "M4",
        # GRT-0232 congestion fix attempt 1 (2026-11-15): the former
        # RTLMP_MIN_CHANNEL_SIZE "16 16" was a silent no-op (not plumbed on
        # this ORFS pin), so the failing run had NO channel/halo control.
        # RTLMP_ARGS replaces the whole generated arg list: -target_util
        # re-states gt2n's PLACE_DENSITY (0.40, no addon); halo 8x8 is the
        # pre-migration MACRO_PLACE_HALO intent; 24um pin-aware channels.
        # Keep CORE_UTILIZATION 46 — BSPDN density is the platform's point;
        # treat congestion as a channel problem first (optimize-ppa skill).
        # Attempt-1 revision: 8um halos + 24um channels together tripped
        # MPL-0065 (movable cells don't fit) — this pin deprecates
        # -halo_width/-halo_height (MPL-0074) and folds halo spacing into
        # channels, so the halos double-reserved area. Channels alone carry
        # the spacing intent.
        "RTLMP_ARGS": "-target_util 0.40 -min_channel_size 24 -pin_aware_channels",
        # GRT-0232 fix attempt 2 (2026-11-15): heatmap shows a saturated
        # open-core logic blob (macro channels were clean) — strengthen
        # GPL routability-driven inflation to spread it locally; keep
        # util 46 (BSPDN density is the platform's point).
        "GLOBAL_PLACEMENT_ARGS": "-routability_max_inflation_ratio 4 -routability_inflation_ratio_coef 5 -routability_max_density 0.6",
        "TNS_END_PERCENT": "100",
        "HOLD_SLACK_MARGIN": "40",
    },
)
