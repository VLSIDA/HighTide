load("//:defs.bzl", "hightide_design")

filegroup(
    name = "sram_lefs",
    srcs = glob(["sram/lef/*.lef"]),
)

filegroup(
    name = "sram_libs",
    srcs = glob(["sram/lib/*.lib"]),
)

# Eyeriss v2 sparse-CNN accelerator on sky130hd. Same RTL as asap7/nangate45
# but FakeRAMs regenerated for the 130nm metal stack via
# designs/src/eyeriss/dev/generated/fakeram_sky130hd.cfg. The sky130hd
# memories are still ~30x the asap7 area, so floorplan utilization is
# intentionally loose to give the placer room around ~157 macros.
hightide_design(
    name = "eyeriss",
    top = "TOP",
    platform = "sky130hd",
    verilog_files = ["//designs/src/eyeriss:rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
    },
    # eyeriss stays on the yosys Verilog frontend: the upstream FPGA-class
    # Verilog-2001 has a trailing comma in a port list and ~10 uses of
    # never-declared identifiers (layer*_flag / psum_acc_times, implicit
    # 1-bit nets under yosys) that slang correctly rejects. Patching the
    # source to satisfy slang would mean inventing semantics for broken
    # upstream logic and changing the benchmark netlist vs baseline.
    yosys_frontend_reason = "upstream Verilog-2001 relies on implicit nets " +
                            "(undeclared layer*_flag/psum_acc_times) and a " +
                            "trailing port-list comma that slang rejects; " +
                            "yosys preserves baseline netlist semantics",
    arguments = {
        "SYNTH_HDL_FRONTEND": "",
        "SYNTH_HIERARCHICAL": "1",
        # Util 20 / halo 40 left the floorplan at 17.4 mm² and 22 %
        # filled — the TOP_controller → pSumSRAM2 critical path (single-
        # fanout distribution signal) crossed half the die through a chain
        # of resizer-inserted buf_4 cells, eating 25.66 ns of the 25 ns
        # period and failing setup by -0.47 ns / TNS -1.36 ns.  With the
        # repartitioned banks=2/4/8/16 macros (all aspect ≤ 2.3), the
        # placer can fit at util 30 / halo 30 — shrinks the floorplan
        # ~33 % so that critical signal traverses fewer buffers.
        "CORE_UTILIZATION": "30",
        "PLACE_DENSITY_LB_ADDON": "0.15",
        "RTLMP_MIN_CHANNEL_SIZE": "60 60",  # was MACRO_PLACE_HALO 30 30 (halo x,y ~ channel 2x,2y)
        "TNS_END_PERCENT": "100",
        # Same ODB-1200 pattern as asap7 — drop split_load from the move
        # sequence to keep the rest of repair_timing active.
        # repair_timing non-convergence on the inter-cluster psum chains
        # (CLAUDE.md table; same pathology as asap7).
        "SKIP_INCREMENTAL_REPAIR": "1",
        "SKIP_LAST_GASP": "1",
    },
)
