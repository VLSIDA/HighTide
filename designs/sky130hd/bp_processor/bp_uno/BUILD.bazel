load("//:defs.bzl", "hightide_design")
load("//designs/src/bp_processor:defs.bzl", "BP_COMMON_ARGS")

_ARGS = dict(BP_COMMON_ARGS)

_ARGS.update({
    # sky130hd port (~710k insts, 22 macros after the wide byte-mask
    # macro rebind — was 140). 2026-11-17 experiment: native RTLMP with
    # the 2026-11 pin's pin-aware channels instead of the fixed macro
    # grid. History: RTLMP's pin-edge-blind clustering wedged macros into
    # met2-pin escape collisions (GRT-0116 capacity:0, same shape as
    # cnn-sky130hd / NVDLA partition_c); a 25 µm-halo RTLMP retry also
    # failed, and the uniform grid needed 900 µm channels (every channel
    # double-sided). -pin_aware_channels trims channels where no macro
    # pins face, so 300 µm uniform channels + trimming is the first
    # probe; fall back to the grid (gen_macro_grid.py --gap-x 250
    # --chan 900 at DIE 8000x8000) if GRT-0116 recurs.
    "CORE_UTILIZATION": "25",
    "CORE_ASPECT_RATIO": "1",
    "RTLMP_MIN_CHANNEL_SIZE": "300 300",
    "RTLMP_PIN_AWARE_CHANNELS": "1",
    "PLACE_PINS_ARGS": "-min_distance 20 -min_distance_in_tracks",
    "PLACE_DENSITY_LB_ADDON": "0.10",
})

hightide_design(
    name = "bp_processor",
    platform = "sky130hd",
    verilog_files = [
        "//designs/src/bp_processor:rtl",
        "//designs/sky130hd/bp_processor:macros",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "PRE_CTS_TCL": ["//designs/src/bp_processor:pre_cts.tcl"],
        "ADDITIONAL_LEFS": ["//designs/sky130hd/bp_processor:sram_lefs"],
        "ADDITIONAL_LIBS": ["//designs/sky130hd/bp_processor:sram_libs"],
    },
    arguments = _ARGS,
    stage_data = {"synth": ["//designs/src/bp_processor:rtl_data"]},
)
