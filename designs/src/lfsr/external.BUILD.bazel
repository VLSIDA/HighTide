# Injected as the BUILD for @lfsr_src (alexforencich/verilog-lfsr).
# Exposes the three RTL files HighTide's lfsr design consumes.
filegroup(
    name = "rtl",
    srcs = [
        "rtl/lfsr.v",
        "rtl/lfsr_prbs_check.v",
        "rtl/lfsr_prbs_gen.v",
    ],
    visibility = ["//visibility:public"],
)

# Upstream verification testbenches, fetched with the RTL (verify-design
# skill). The cocotb segment (tb/lfsr_prbs_gen/test_lfsr_prbs_gen.py) is the
# design's verification surface, wired up in BUILD.bazel's lfsr_cocotb.
# Upstream's tb/test_*.v harnesses are myhdl-coupled (they $from/$to_myhdl)
# and out of scope; only the cocotb test module is exposed here.
filegroup(
    name = "sim_sources",
    srcs = glob([
        "tb/**/*.v",
        "tb/**/*.py",
        "tb/**/Makefile",
    ]),
    visibility = ["//visibility:public"],
)


