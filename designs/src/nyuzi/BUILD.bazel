# NyuziProcessor RTL: upstream SystemVerilog (jbush001/NyuziProcessor @
# ed5c1a50, via @nyuzi_src) lowered to Verilog-2005 by sv2v (pinned v0.0.13,
# @sv2v).  Fully hermetic — no dev/repo submodule, no dev/setup.sh (which
# built sv2v from an unpinned Haskell Stack checkout of master).
#
# The fakeram-swap patch (applied declaratively on @nyuzi_src) rewrites the
# generic sram_1r1w / sram_2r1w / cache_lru instantiations to FakeRAM macros;
# those three source modules are excluded from the sv2v input and provided by
# the checked-in cache_lru.v (cache_lru_4x64) and macros.v (the fakerams).
# nyuziTop.sv is the HighTide-authored top wrapper (also checked in).

genrule(
    name = "gen_nyuzi",
    srcs = [
        "nyuziTop.sv",
        "@nyuzi_src//:core_sv",
        "@nyuzi_src//:core_headers",
    ],
    outs = ["NyuziProcessor.v"],
    cmd = """
set -e
INCDIR=$$(dirname $$(echo '$(locations @nyuzi_src//:core_headers)' | tr ' ' '\\n' | grep 'defines[.]svh$$' | head -1))
$(execpath @sv2v//:sv2v_bin) --top NyuziProcessor -w $@ \
    -I "$$INCDIR" \
    $(execpath nyuziTop.sv) \
    $(locations @nyuzi_src//:core_sv)
""",
    tools = ["@sv2v//:sv2v_bin"],
)

filegroup(
    name = "rtl",
    srcs = [
        ":gen_nyuzi",
        "cache_lru.v",
        "macros.v",
    ],
    visibility = ["//visibility:public"],
)
