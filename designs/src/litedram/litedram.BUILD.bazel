load("@rules_python//python:defs.bzl", "py_library")

# Injected BUILD for @litedram_src (enjoy-digital/litedram).  Imported as
# top-level `litedram`; carries the standalone-core generator litedram/gen.py.
py_library(
    name = "litedram",
    srcs = glob(["litedram/**/*.py"]),
    data = glob(["litedram/**/*"], exclude = ["litedram/**/*.py", "**/__pycache__/**"], allow_empty = True),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@litex_src//:litex",
        "@pip_litex//pyyaml",
    ],
)
