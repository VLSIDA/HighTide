# RTL sources for the LiteDRAM standalone-core benchmark.
#
# litedram_core.v is generated hermetically by Bazel from the upstream
# enjoy-digital/litedram standalone generator: migen/litex/litedram are
# fetched as pinned source archives (@migen_src/@litex_src/@litedram_src in
# the root MODULE.bazel) and run under the :litedram_gen py_binary — no git
# submodule, no dev/setup.sh venv.  See :gen_litedram_core below.
#
# `libraries/lattice/*.v` provides ASIC-synthesizable stubs for the four
# Lattice ECP5 primitives that GENSDRPHY's I/O cells instantiate
# (FD1S3BX, OFS1P3BX, IFS1P3BX, TRELLIS_IO) — the core controller logic
# itself has no vendor dependency.  These are HighTide-authored, not
# upstream, so they stay checked in.

load("@rules_python//python:defs.bzl", "py_binary")

# Hermetic LiteDRAM standalone-core generator (migen/litex/litedram fetched
# as source archives; see root MODULE.bazel).  Replaces dev/setup.sh's venv.
py_binary(
    name = "litedram_gen",
    srcs = ["litedram_gen_main.py"],
    main = "litedram_gen_main.py",
    visibility = ["//visibility:private"],
    deps = ["@litedram_src//:litedram"],
)

# Run the generator on litedram.yml, rewrite the DQ pad boundary for ASIC
# synthesis, and normalize LiteX's build-timestamp header lines so the
# output is byte-reproducible (deterministic Bazel caching).
# PYTHONHASHSEED=0 pins LiteX's blackbox-listing order in the header comment.
#
# ASIC-boundary rewrite (2026-11, replaces the old input->inout patch):
# LiteX declares the bidirectional SDR DQ bus as `input sdram_dq` and
# drives it through 16 TRELLIS_IO tristate pads. ASIC libs have no
# tristate cells, so yosys 0.68's `check -assert` rejects the unmapped
# $_TBUF_ cells (the old toolchain only passed because SYNTH_HIERARCHICAL
# hid them inside unexpanded TRELLIS_IO shells). The top is renamed
# `litedram_asic` and `sdram_dq` is split into the standard pad-ring
# triple `sdram_dq_i` / `sdram_dq_o` / `sdram_dq_oe`, wired per-bit to
# the split-port TRELLIS_IO stub (libraries/lattice/TRELLIS_IO.v) — no
# tristate anywhere, full write datapath preserved.
genrule(
    name = "gen_litedram_core",
    srcs = ["litedram.yml"],
    outs = ["litedram_core.v"],
    cmd = """
set -e
BIN=$$(readlink -f $(execpath :litedram_gen))
YML=$$(readlink -f $(execpath litedram.yml))
GENDIR=$$(pwd)/_litedram_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && PYTHONHASHSEED=0 HOME="$$GENDIR" "$$BIN" "$$YML" ) >/dev/null
CORE="$$GENDIR/build/gateware/litedram_core.v"
sed -E -i \
    -e 's|^module litedram_core \\(|module litedram_asic (|' \
    -e 's|^    input  wire   \\[15:0\\] sdram_dq,$$|    input  wire   [15:0] sdram_dq_i,\\n    output wire   [15:0] sdram_dq_o,\\n    output wire   [15:0] sdram_dq_oe,|' \
    -e 's|\\.B \\(sdram_dq\\[([0-9]+)\\]\\),|.B_i (sdram_dq_i[\\1]),\\n\\t.B_o (sdram_dq_o[\\1]),\\n\\t.B_oe (sdram_dq_oe[\\1]),|' \
    -e 's|^// Date       : .*|// Date       : (normalized for reproducible build)|' \
    -e 's|^//  Auto-Generated by LiteX on .*|//  Auto-Generated by LiteX (normalized for reproducible build)|' \
    "$$CORE"
grep -q '^module litedram_asic (' "$$CORE"
test "$$(grep -cF '.B_i (sdram_dq_i[' "$$CORE")" -eq 16
if grep -qE '(^|[^_a-zA-Z0-9])sdram_dq([^_a-zA-Z0-9]|$$)' "$$CORE"; then
    echo "gen_litedram_core: unsplit sdram_dq reference remains" >&2
    exit 1
fi
cp "$$CORE" $@
rm -rf "$$GENDIR"
""",
    tools = [":litedram_gen"],
)

filegroup(
    name = "lattice_libs",
    srcs = glob(["libraries/lattice/*.v"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "litedram_rtl",
    srcs = [
        ":gen_litedram_core",
        ":lattice_libs",
    ],
    visibility = ["//visibility:public"],
)
