# RTL sources for the LiteEth standalone-core benchmark (UDP endpoint over the
# Xilinx UltraScale+ GTH-SerDes SGMII PHY; top module liteeth_udp_usp_gth_sgmii).
#
# The core .v is generated hermetically by Bazel from the upstream
# enjoy-digital/liteeth standalone generator: migen/litex are the shared LiteX
# toolchain archives (@migen_src/@litex_src), plus @liteeth_src and @liteiclink_src
# (the GTH PHY needs liteiclink), run under the :liteeth_gen py_binary — no git
# submodule, no dev/setup.sh venv.  See :gen_liteeth_core below.
#
# `libraries/xilinx/*.v` (incl. GTHE4_CHANNEL_DUMMY) and `macros.v` are
# HighTide-authored ASIC stubs and stay checked in.

load("@rules_python//python:defs.bzl", "py_binary")

# Hermetic LiteEth standalone-core generator (reuses the shared LiteX
# toolchain @migen_src/@litex_src + pip_litex; liteeth from @liteeth_src,
# GTH PHY dep from @liteiclink_src).
py_binary(
    name = "liteeth_gen",
    srcs = ["liteeth_gen_main.py"],
    main = "liteeth_gen_main.py",
    visibility = ["//visibility:private"],
    deps = ["@liteeth_src//:liteeth"],
)

# Generate liteeth_core.v, then apply the ASIC-adaptation patch (rename module
# to liteeth_udp_usp_gth_sgmii, comment out $readmemh ROM inits, swap the real
# GTHE4_CHANNEL transceiver for the GTHE4_CHANNEL_DUMMY stub), and normalize
# LiteX's build-timestamp header lines for byte-reproducible output.
# PYTHONHASHSEED=0 pins LiteX's blackbox-listing order in the header comment.
genrule(
    name = "gen_liteeth_core",
    srcs = [
        "liteeth_udp_usp_gth_sgmii.yml",
        "patches/liteeth_udp_usp_gth_sgmii.patch",
    ],
    outs = ["liteeth_udp_usp_gth_sgmii.v"],
    cmd = """
set -e
BIN=$$(readlink -f $(execpath :liteeth_gen))
YML=$$(readlink -f $(execpath liteeth_udp_usp_gth_sgmii.yml))
PATCHF=$$(readlink -f $(execpath patches/liteeth_udp_usp_gth_sgmii.patch))
GENDIR=$$(pwd)/_liteeth_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && PYTHONHASHSEED=0 HOME="$$GENDIR" "$$BIN" "$$YML" ) >/dev/null
CORE="$$GENDIR/build/gateware/liteeth_core.v"
patch -s -p0 "$$CORE" < "$$PATCHF"
sed -E -i \
    -e 's|^// Date       : .*|// Date       : (normalized for reproducible build)|' \
    -e 's@^(reg +(\\[[0-9]+:[0-9]+\\] +)?[a-zA-Z_][a-zA-Z_0-9]*) = [a-zA-Z_][a-zA-Z_0-9]*;@\\1;@' \
    -e 's|^//  Auto-Generated by LiteX on .*|//  Auto-Generated by LiteX (normalized for reproducible build)|' \
    "$$CORE"
cp "$$CORE" $@
rm -rf "$$GENDIR"
""",
    tools = [":liteeth_gen"],
)

# Vendor library filegroups (HighTide-authored ASIC stubs, kept checked in).
filegroup(
    name = "xilinx_libs",
    srcs = glob(["libraries/xilinx/*.v"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "liteeth_rtl",
    srcs = [
        ":gen_liteeth_core",
        ":xilinx_libs",
    ],
    visibility = ["//visibility:public"],
)
