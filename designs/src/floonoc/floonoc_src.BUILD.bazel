load("@rules_python//python:defs.bzl", "py_library")

# Injected BUILD for @floonoc_src (pulp-platform/FlooNoC).  Exposes both the
# hardware RTL (hw/**, selected by designs/src/floonoc/srcs.bzl) and the FlooGen
# NoC generator (the floogen/ Python package), which runs under Bazel via the
# :floonoc_gen py_binary in the design BUILD to emit the mesh topology RTL.

exports_files(
    glob(["hw/**/*", "include/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# FlooNoC hw/include headers, staged for VERILOG_INCLUDE_DIRS.
filegroup(
    name = "hw_include",
    srcs = glob(["hw/include/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# FlooGen mesh-topology generator (bundled in the repo).  Renders SystemVerilog
# from mesh_config.yml via mako templates; deps from the pip_floogen hub.
py_library(
    name = "floogen",
    srcs = glob(["floogen/**/*.py"], allow_empty = True),
    data = glob(
        ["floogen/templates/**", "floogen/examples/**"],
        allow_empty = True,
    ),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@pip_floogen//click",
        "@pip_floogen//mako",
        "@pip_floogen//matplotlib",
        "@pip_floogen//networkx",
        "@pip_floogen//pydantic",
        "@pip_floogen//ruamel_yaml",
    ],
)
