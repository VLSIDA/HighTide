# FlooNoC RTL sources.
#
# This design uses yosys-slang (SYNTH_HDL_FRONTEND=slang) to read
# SystemVerilog directly. The RTL is generated by setup.sh which runs
# bender and floogen, producing file lists that reference .sv files
# across bender-managed dependency directories.

# update-rtl mode: init submodule + run setup.sh to generate RTL via
# bender + floogen.
genrule(
    name = "rtl_dev_gen",
    srcs = glob(
        ["dev/**"],
        exclude = [
            "dev/generated/**",
            "dev/repo/**",
            "dev/bender",
        ],
    ),
    outs = ["floonoc_rtl.tar"],
    local = True,
    cmd = """
        WORKSPACE_ROOT=$$(readlink -f $(location //:tools/update_rtl.sh) | sed 's|/tools/update_rtl.sh||')
        cd $$WORKSPACE_ROOT
        git submodule update --init designs/src/floonoc/dev/repo >&2
        bash designs/src/floonoc/dev/setup.sh >&2
        DEV_DIR=designs/src/floonoc/dev
        cd $$DEV_DIR
        tar cf $$OLDPWD/$(OUTS) $$(cat generated/files.txt) $$(cat generated/includes.txt | sed 's|$$|/*.sv|' | xargs -I{} sh -c 'ls {} 2>/dev/null || true')
    """,
    tools = [
        "dev/setup.sh",
        "//:tools/update_rtl.sh",
    ],
)

filegroup(
    name = "rtl",
    srcs = glob(["dev/generated/**/*.sv"]) + glob(["dev/repo/.bender/**/*.sv"]) + glob(["dev/repo/hw/**/*.sv"]),
    visibility = ["//visibility:public"],
)
