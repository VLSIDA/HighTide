load("@rules_python//python:defs.bzl", "py_library")

# Injected BUILD for @snitch_cluster_src (pulp-platform/snitch_cluster).
# Exposes the cluster hardware RTL (hw/**, selected by srcs.bzl — including the
# pre-generated snitch_cluster_peripheral_reg[_pkg].sv that ship in-tree) and
# the clustergen wrapper/pkg generator (util/clustergen), which runs under Bazel
# via :snitch_cluster_gen in the design BUILD.

exports_files(
    glob(["hw/**/*"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# All hw/**/include header dirs, staged for VERILOG_INCLUDE_DIRS.
filegroup(
    name = "hw_includes",
    srcs = glob(["hw/**/include/**"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# clustergen wrapper/pkg generator (util/clustergen); json5/jsonref/jsonschema/
# mako come from the pip_clustergen hub.  imports points at util/clustergen so
# clustergen.py's `from cluster import SnitchCluster` resolves.
py_library(
    name = "clustergen",
    srcs = glob(["util/clustergen/**/*.py"], allow_empty = True),
    data = glob(
        ["util/clustergen/**/*.json", "util/clustergen/**/*.schema.json"],
        allow_empty = True,
    ),
    imports = ["util/clustergen"],
    visibility = ["//visibility:public"],
    deps = [
        "@pip_clustergen//json5",
        "@pip_clustergen//jsonref",
        "@pip_clustergen//jsonschema",
        "@pip_clustergen//mako",
    ],
)
