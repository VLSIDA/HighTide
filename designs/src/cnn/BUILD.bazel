# RTL for the NNgen CNN accelerator benchmark.
#
# cnn.v is generated hermetically by Bazel from the upstream NNgen model
# builder: @nngen_src (examples/cnn/cnn.py) runs under the :cnn_gen py_binary
# with veriloggen/onnx/numpy from the pip_nngen hub — no git submodule, no
# dev/setup.sh venv.  NNgen infers register-array memories; :replace_rams then
# rewrites each `ram_w<W>_l<L>_*` module into a wrapper instantiating the
# matching bsg_fakeram macro (byte-identical to the retired shell flow).
#
# The behavioural fakeram_w*_l*.v stubs (HighTide/bsg_fakeram, not upstream
# NNgen) are kept for simulation reference but are NOT in the :rtl filegroup:
# under the slang frontend (2026-11 default) the macros are blackboxed via
# --blackboxed-module (derived from ADDITIONAL_LIBS), and feeding the stubs
# to slang attaches their corrupt_mem_on_X_p parameter to the specialized
# instances, which then fail to bind to the parameterless liberty blackbox
# at the yosys hierarchy pass. The per-platform FakeRAM LEF/LIB live under
# designs/<platform>/cnn/sram/.

load("@rules_python//python:defs.bzl", "py_binary")

# Hermetic NNgen CNN generator (nngen fetched as a source archive; veriloggen/
# onnx/numpy from pip_nngen — see root MODULE.bazel).  Replaces the venv.
py_binary(
    name = "cnn_gen",
    srcs = ["cnn_gen_main.py"],
    main = "cnn_gen_main.py",
    visibility = ["//visibility:private"],
    deps = ["@nngen_src//:nngen"],
)

# Inferred-RAM -> fakeram-wrapper rewriter (stdlib only, no deps).
py_binary(
    name = "replace_rams",
    srcs = ["replace_rams.py"],
    main = "replace_rams.py",
    visibility = ["//visibility:private"],
)

# Generate cnn.v: NNgen's to_ipxact emits cnn_v*/hdl/cnn.v (simulation off),
# then rewrite inferred RAM modules into fakeram wrappers.  PYTHONHASHSEED=0
# pins veriloggen's dict-ordered emission so the output is byte-reproducible.
genrule(
    name = "gen_cnn",
    outs = ["cnn.v"],
    cmd = """
set -e
GEN=$$(readlink -f $(execpath :cnn_gen))
RR=$$(readlink -f $(execpath :replace_rams))
GENDIR=$$(pwd)/_cnn_gen
mkdir -p "$$GENDIR"
( cd "$$GENDIR" && PYTHONHASHSEED=0 HOME="$$GENDIR" "$$GEN" "$$GENDIR/cnn.v" ) >/dev/null
PYTHONHASHSEED=0 "$$RR" "$$GENDIR/cnn.v"
cp "$$GENDIR/cnn.v" $@
rm -rf "$$GENDIR"
""",
    tools = [
        ":cnn_gen",
        ":replace_rams",
    ],
)

filegroup(
    name = "rtl",
    srcs = [
        ":gen_cnn",
    ],
    visibility = ["//visibility:public"],
)
