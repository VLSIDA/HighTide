load("//:defs.bzl", "hightide_design")

filegroup(
    name = "sram_lefs",
    srcs = glob(["sram/lef/*.lef"]),
)

filegroup(
    name = "sram_libs",
    srcs = glob(["sram/lib/*.lib"]),
)

hightide_design(
    name = "coralnpu",
    platform = "asap7",
    top = "CoreMiniAxi",
    verilog_files = ["//designs/src/coralnpu:rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
    },
    arguments = {
        # coralnpu is now Chisel-7 SystemVerilog (via firtool) → yosys-slang.
        "SYNTH_HDL_FRONTEND": "slang",
        "SYNTH_SLANG_ARGS": "--disable-instance-caching=false -DUSE_GENERIC -Iexternal/+_repo_rules+common_cells/include",
        "SYNTH_HIERARCHICAL": "1",
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY_LB_ADDON": "0.20",
        "RTLMP_MIN_CHANNEL_SIZE": "12 12",  # was MACRO_PLACE_HALO 6 6 (halo x,y ~ channel 2x,2y)
        "TNS_END_PERCENT": "100",
    },
)
