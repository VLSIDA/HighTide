load("//:defs.bzl", "hightide_design")
load("//designs/src/bp_processor:defs.bzl", "BP_COMMON_ARGS")

_ARGS = dict(BP_COMMON_ARGS)

_ARGS.update({
    # 2026-11-17: utilization-driven floorplan (was fixed 900x900, ~28%
    # occupied — never pressure-tested). Matches the gt2n port's style
    # and the bp_quad util-40 push. min_channel 12 12 is the halo-6
    # replacement (upstream deprecated halo args; channel = 2x halo) and
    # IS plumbed on the 2026-11 pin; pin-aware trimming engages with it.
    "CORE_UTILIZATION": "40",
    "CORE_ASPECT_RATIO": "1",
    "RTLMP_MIN_CHANNEL_SIZE": "12 12",
    "PLACE_PINS_ARGS": "-min_distance 20 -min_distance_in_tracks",
    "PLACE_DENSITY_LB_ADDON": "0.10",
    # Post-GRT repair_timing hangs silently for 2h+ on k8s under the
    # new bsg_fakeram macros — same non-convergence pattern as
    # liteeth/asap7 (88b7ef46) and cnn/asap7 (9d9c5309). Skip it;
    # route's own hold-repair still runs.
    "SKIP_INCREMENTAL_REPAIR": "1",
})

hightide_design(
    name = "bp_processor",
    platform = "asap7",
    verilog_files = [
        "//designs/src/bp_processor:rtl",
        "//designs/asap7/bp_processor:macros",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "PRE_CTS_TCL": ["//designs/src/bp_processor:pre_cts.tcl"],
        "ADDITIONAL_LEFS": ["//designs/asap7/bp_processor:sram_lefs"],
        "ADDITIONAL_LIBS": ["//designs/asap7/bp_processor:sram_libs"],
    },
    arguments = _ARGS,
    stage_data = {"synth": ["//designs/src/bp_processor:rtl_data"]},
)
