load("//:defs.bzl", "hightide_design")
load("//designs/src/bp_processor:defs.bzl", "BP_COMMON_ARGS")

_ARGS = dict(BP_COMMON_ARGS)

_ARGS.update({
    "VERILOG_TOP_PARAMS": "bp_params_p 11",
    # 2026-11-17: utilization-driven floorplan. The explicit-die era
    # (4000x4000 -> 3000x3000) existed for the 560-macro RTLMP/MPL-0040
    # workarounds; the byte-mask rebind (88 macros) removed that need,
    # and the 3000x3000 first close was only 10% occupied (865k um2
    # placed, 39 m of wire). Util 40 ~= 1475x1475 die. Watch the M4
    # Lef58EolKeepOut plateau asap7 bsg-fakeram designs hit when packed.
    "CORE_UTILIZATION": "40",
    "CORE_ASPECT_RATIO": "1",
    # Same 12 um channels as bp_uno-asap7: at 40% util RTLMP's default
    # 0.0 channel floor could butt macros together; the roomy first
    # close never needed one. Plumbed on the 2026-11 pin.
    "RTLMP_MIN_CHANNEL_SIZE": "12 12",
    "PLACE_DENSITY_LB_ADDON": "0.10",
    # New-resizer (2026-07 tools, OpenROAD b65c274c) repair_timing does not
    # converge on bp_quad's worst reg2reg path — a structural memory path with
    # WNS ~-4900 ps that no buffering can fix.  Both the CTS-time and post-GRT
    # repair_timing passes spin (TNS crawls ~48 ps/iter, iteration count climbs
    # unbounded) so the flow never finishes.  bp_uno converges (its WNS is
    # manageable); bp_quad (4 cores) does not.  Skip both repair passes so the
    # design reaches _final; detail route still does its own hold repair.
    "SKIP_CTS_REPAIR_TIMING": "1",
    "SKIP_INCREMENTAL_REPAIR": "1",
    # 2026-11-17: analyze_power_grid SIGSEGVs at _final on this netlist —
    # psm::IRSolver::solve -> Eigen SparseLU analyzePattern ->
    # COLAMDOrdering<int> faults on the VDD conductance matrix (2.8M nets;
    # int-indexed COLAMD workspace sizing). gdb-confirmed repro from
    # 5_route.odb. Empty voltage dicts make final_outputs.tcl skip IR-drop
    # entirely (both vars are final-stage-scoped, so earlier stages stay
    # cached). Re-enable once upstream PSM handles grids this size.
    "PWR_NETS_VOLTAGES": "",
    "GND_NETS_VOLTAGES": "",
})

hightide_design(
    name = "bp_processor",
    platform = "asap7",
    verilog_files = [
        "//designs/src/bp_processor:rtl",
        "//designs/asap7/bp_processor:macros",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "PRE_CTS_TCL": ["//designs/src/bp_processor:pre_cts.tcl"],
        "IO_CONSTRAINTS": [":io.tcl"],
        "ADDITIONAL_LEFS": ["//designs/asap7/bp_processor:sram_lefs"],
        "ADDITIONAL_LIBS": ["//designs/asap7/bp_processor:sram_libs"],
    },
    arguments = _ARGS,
    stage_data = {"synth": ["//designs/src/bp_processor:rtl_data"]},
)
