load("//:defs.bzl", "hightide_design")

package(default_visibility = ["//designs/asap7/litepci:__subpackages__"])

# FakeRAM macros for the five distinct memory geometries litepcie_core
# infers (1rw + 1r, sync read).  Generated by bsg_fakeram from
# designs/src/litepci/dev/generated/fakeram_asap7.cfg.
filegroup(
    name = "sram_lefs",
    srcs = glob(["sram/lef/*.lef"]),
)

filegroup(
    name = "sram_libs",
    srcs = glob(["sram/lib/*.lib"]),
)

# Placeholder LEF/LIB for the pcie_us Xilinx PCIe hard-IP blackbox.
# Committed (not regenerated at flow time) so synth_odb has a master for
# the blackbox; produced by designs/src/litepci/dev/gen_phy_lef.py via
# dev/gen.sh. See designs/src/litepci/BUILD.bazel.
filegroup(
    name = "phy_lefs",
    srcs = glob(["phy/lef/*.lef"]),
)

filegroup(
    name = "phy_libs",
    srcs = glob(["phy/lib/*.lib"]),
)

# LitePCIe core (kcu105 / USPCIEPHY config) on asap7.
#
# The Xilinx PCIe hard IP (`pcie_us`) and the GT diff-clock buffer
# (`IBUFDS_GTE3`) are FPGA-only — the former is declared (* blackbox *)
# in pcie_us_stub.v, the latter has a synthesizable passthrough that
# maps to an ASAP7 BUFx2 via `USE_ASAP7_CELLS`.
hightide_design(
    name = "litepci",
    top = "litepcie_core",
    platform = "asap7",
    verilog_files = ["//designs/src/litepci:rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs", ":phy_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs", ":phy_libs"],
    },
    arguments = {
        "VERILOG_DEFINES": "-D USE_ASAP7_CELLS",
        # Real-FakeRAM build: dev/inline_fakeram.py wires the 20 large DMA /
        # TLP memories to explicit fakeram instances so STA sees real
        # register-to-register paths (single-clock SDC on pcie_us/user_clk).
        # util 75: best measured PPA point.  vs util 60: die -20%
        # (816k->653k um^2), setup TNS -75% (-9672->-2392 ps), 3 setup
        # violations.  Reg-to-reg setup MET (+758 ps at 3.6 ns).  Hold is
        # structurally skew-bound and util-independent (see DECISIONS.md):
        # the fixed LiteX RTL clocks 20 DMA/TLP FakeRAMs (~59-74% of any
        # util-reasonable die) from one small clock-source pin
        # (pcie_us/user_clk), so CTS cannot build a low-skew tree.  Tried
        # one-block / perimeter-ring / two-band macro placements: all
        # exceed the die's area or perimeter before leaving room for a
        # balanced central clock spine.
        "CORE_UTILIZATION": "75",
        "PLACE_DENSITY": "0.80",
        "RTLMP_MIN_CHANNEL_SIZE": "10 10",  # was MACRO_PLACE_HALO 5 5 (halo x,y ~ channel 2x,2y)
        # Allow no GDS for fakeram macros and the pcie_us blackbox.
        "GDS_ALLOW_EMPTY": "fakeram.*|pcie_us",
        # Skip the post-GRT repair_timing block.  Two reasons:
        #  (1) ODB-1200 — InsertBufferBeforeLoads iterates a stale load list and
        #      aborts when SplitLoadMove fires; the hold pass calls split_load too.
        #  (2) new resizer (2026-06 tools) — repair_timing does not converge on the
        #      forwarded-clock reg2reg path (WNS ~-898 ps is a structural LiteX
        #      user_clk feedthrough, not silicon; TNS decays asymptotically and the
        #      pass never terminates, ~1450 iters/hr with no closure).
        # NOTE: this arg was previously described in a comment but never actually
        # set, so the flow ran the (non-converging) repair anyway.  Now set.
        "SKIP_INCREMENTAL_REPAIR": "1",
    },
)
