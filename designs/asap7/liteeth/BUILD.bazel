load("//:defs.bzl", "hightide_design")

package(default_visibility = ["//designs/asap7/liteeth:__pkg__"])

# SRAM macros instantiated by the liteeth UDP-USP-GTH-SGMII config.
filegroup(
    name = "sram_lefs",
    srcs = [
        "sram/lef/fakeram_1rw1r_64w64d_sram.lef",
        "sram/lef/fakeram_1rw1r_64w1024d_sram.lef",
    ],
)

filegroup(
    name = "sram_libs",
    srcs = [
        "sram/lib/fakeram_1rw1r_64w64d_sram.lib",
        "sram/lib/fakeram_1rw1r_64w1024d_sram.lib",
    ],
)

# LiteEth UDP endpoint over the Xilinx UltraScale+ GTH SGMII PHY.
# Verilog top module stays `liteeth_udp_usp_gth_sgmii` (LiteX-generated);
# `name` is the short Bazel target / display name.
hightide_design(
    name = "liteeth",
    top = "liteeth_udp_usp_gth_sgmii",
    platform = "asap7",
    verilog_files = ["//designs/src/liteeth:liteeth_rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
        "MACRO_PLACEMENT_TCL": [":macros.tcl"],
    },
    arguments = {
        "VERILOG_DEFINES": "-D USE_ASAP7_CELLS",
        # Manual floorplan (macros.tcl), 2026-11-24, adapted from the sweep
        # agent's stacked layout: die 255.0 x 376.9 um = util 0.82 incl
        # macros (was CORE_UTILIZATION 45 via RTLMP, which put the logic far
        # from the FIFOs: a 575 ps wire on the critical path). The 2026-11-19
        # bazeltuner result (900ps/45/0.55/4um) measured the GTH-stub
        # netlist and is void.
        "DIE_AREA": "0 0 254.988 376.92",
        "CORE_AREA": "1.08 1.08 253.908 375.84",
        # One-parameter scout wave on the manual floorplan (2026-11-25, see
        # DECISIONS.md): clock 900 -> 810 ps, hierarchical synthesis, and
        # CTS + post-GRT repair_timing back on (SKIP_CTS_REPAIR_TIMING /
        # SKIP_INCREMENTAL_REPAIR removed). Final: 1.252 GHz system clock,
        # setup clean, 0 DRC. Density 0.55 -> 0.65 is PPA-neutral at global
        # route but is the variant that closed setup at final.
        "SYNTH_HIERARCHICAL": "1",
        "PLACE_DENSITY": "0.65",
    },
)
