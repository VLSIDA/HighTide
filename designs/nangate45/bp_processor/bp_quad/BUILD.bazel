load("//:defs.bzl", "hightide_design")
load("//designs/src/bp_processor:defs.bzl", "BP_COMMON_ARGS")

_ARGS = dict(BP_COMMON_ARGS)

_ARGS.update({
    "VERILOG_TOP_PARAMS": "bp_params_p 11",
    # 2026-11-15: byte-mask macro rebind (560 -> 88 macros, 2.10 Mum2 of
    # macro vs 5.30 before). The old 8000x8000 die was sized for RTLMP
    # headroom at 560 macros and ran at ~15% occupancy (85% fill cells,
    # clumped placement, mid-edge pin clusters). Resize to 5000x5000
    # (~24% occupancy: ~6.1 Mum2 instances in a 25 Mum2 core) —
    # deliberately roomy first pass; tighten in a later PPA round.
    "DIE_AREA": "0 0 5000 5000",
    "CORE_AREA": "10 10 4990 4990",
    "PLACE_DENSITY_LB_ADDON": "0.10",
    # Spread the IO pins (mirrors asap7 bp_quad); without it place_pins
    # packs them mid-edge toward the interior logic.
    "PLACE_PINS_ARGS": "-min_distance 20 -min_distance_in_tracks",
    # See asap7 bp_quad: new-resizer repair_timing does not converge on the
    # structural -4900 ps memory path; skip the CTS-time and post-GRT repair
    # passes so the flow finishes (route still hold-repairs).
    "SKIP_CTS_REPAIR_TIMING": "1",
    "SKIP_INCREMENTAL_REPAIR": "1",
})

hightide_design(
    name = "bp_processor",
    platform = "nangate45",
    verilog_files = [
        "//designs/src/bp_processor:rtl",
        "//designs/nangate45/bp_processor:macros",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "PRE_CTS_TCL": ["//designs/src/bp_processor:pre_cts.tcl"],
        "ADDITIONAL_LEFS": ["//designs/nangate45/bp_processor:sram_lefs"],
        "ADDITIONAL_LIBS": ["//designs/nangate45/bp_processor:sram_libs"],
    },
    arguments = _ARGS,
    stage_data = {"synth": ["//designs/src/bp_processor:rtl_data"]},
)
