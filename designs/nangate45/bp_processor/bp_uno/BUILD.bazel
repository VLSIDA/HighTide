load("//:defs.bzl", "hightide_design")
load("//designs/src/bp_processor:defs.bzl", "BP_COMMON_ARGS")

_ARGS = dict(BP_COMMON_ARGS)

_ARGS.update({
    # 2026-11-17: utilization-driven floorplan. The fixed 3500x3500 die
    # and its tuning history (MPL-0040 at util 35/25, MPL-0065 at DIE
    # 2500, PDN-0179 at halo 6) all predate the byte-mask macro rebind
    # (560 -> ~22 macros) and no longer bind. min_channel 50 50 is the
    # halo-25 replacement (upstream deprecated halo args; channel = 2x
    # halo), kept for PDN stripe room — and IS plumbed on the 2026-11
    # pin. Util 35 (not 40) for nangate45's coarser routing pitch.
    "CORE_UTILIZATION": "35",
    "CORE_ASPECT_RATIO": "1",
    "RTLMP_MIN_CHANNEL_SIZE": "50 50",
    "PLACE_PINS_ARGS": "-min_distance 10 -min_distance_in_tracks",  # 20 tracks overflowed the perimeter on the util-sized die (PPL-0024: 1389 pins need 7778 um vs 7053 um at 20)
    "PLACE_DENSITY_LB_ADDON": "0.10",
})

hightide_design(
    name = "bp_processor",
    platform = "nangate45",
    verilog_files = [
        "//designs/src/bp_processor:rtl",
        "//designs/nangate45/bp_processor:macros",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        # repair_clock_inverters SEGV (OpenROAD #12250) on this netlist too —
        # first bp_uno-nangate45 CTS on the 2026-11 pin; same modnet strip as
        # the NVDLA partitions (see CLAUDE.md workaround table).
        "PRE_CTS_TCL": ["//designs/src/bp_processor:pre_cts.tcl"],
        "ADDITIONAL_LEFS": ["//designs/nangate45/bp_processor:sram_lefs"],
        "ADDITIONAL_LIBS": ["//designs/nangate45/bp_processor:sram_libs"],
    },
    arguments = _ARGS,
    stage_data = {"synth": ["//designs/src/bp_processor:rtl_data"]},
)
