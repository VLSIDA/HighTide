load("//:defs.bzl", "hightide_design")

filegroup(
    name = "sram_lefs",
    srcs = glob(["sram/lef/*.lef"]),
)

filegroup(
    name = "sram_libs",
    srcs = glob(["sram/lib/*.lib"]),
)

hightide_design(
    name = "ternip",
    platform = "nangate45",
    top = "ternip_core",
    verilog_files = [
        "//designs/src/ternip:rtl",
        # Shared FakeRAM wrapper — the macro name is identical across platforms
        # (just regenerated with each platform's tech params via
        # tools/regenerate_sram.sh), so the same wrapper binds correctly.
        "//designs/src/ternip:ternip_pipelined_mem_fakeram.v",
    ],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
    },
    arguments = {
        "SYNTH_HDL_FRONTEND": "slang",
        "SYNTH_HIERARCHICAL": "0",
        "VERILOG_INCLUDE_DIRS": "designs/src/ternip external/+http_archive+ternip_src/rtl external/+http_archive+basejump_stl_src/bsg_misc external/+http_archive+basejump_stl_src/bsg_dataflow external/+http_archive+basejump_stl_src/bsg_mem",
        "VERILOG_DEFINES": "-DCONFIG_FILENAME=\\\"config/hightide.svh\\\" -DSYNTHESIS",
        "CORE_UTILIZATION": "70",
        "PLACE_DENSITY": "0.75",
        "RTLMP_MIN_CHANNEL_SIZE": "12 12",  # was MACRO_PLACE_HALO 6 6 (halo x,y ~ channel 2x,2y)
        "TNS_END_PERCENT": "100",
        # importvector (4096 x 10 = 40960 bits) is flip-flops in the wrapper
        # (depth 10 is below fakeram's minimum); yosys still counts the
        # ram_style="registers" array against this threshold.
        "SYNTH_MEMORY_MAX_BITS": "40960",
    },
    stage_data = {"synth": ["//designs/src/ternip:rtl_data"]},
)
