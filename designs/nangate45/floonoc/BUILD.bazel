load("//:defs.bzl", "hightide_design")

filegroup(name = "sram_lefs", srcs = glob(["sram/lef/*.lef"]))

filegroup(name = "sram_libs", srcs = glob(["sram/lib/*.lib"]))

hightide_design(
    name = "floonoc",
    top = "floonoc_mesh_top",
    platform = "nangate45",
    verilog_files = ["//designs/src/floonoc:rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
        "MACRO_PLACEMENT_TCL": [":macros.tcl"],
    },
    stage_data = {"synth": ["//designs/src/floonoc:rtl_data"]},
    arguments = {
        "SYNTH_HDL_FRONTEND": "slang",
        "VERILOG_INCLUDE_DIRS": "external/+http_archive+pulp_common_cells_src/include external/+http_archive+pulp_apb_src/include external/+http_archive+pulp_axi_src/include external/+http_archive+pulp_axi_stream_src/include external/+http_archive+pulp_obi_src/include external/+http_archive+pulp_register_interface_src/include external/+http_archive+floonoc_src/hw/include",
        "VERILOG_DEFINES": "-D VERILATOR",
        # Mesh-tiled floorplan (macros.tcl): the 16 cluster memories sit
        # in a 4x4 grid in mesh order (gen_x = column from west, gen_y =
        # row from south), each centered in its own tile beside its
        # router. RTLMP had clustered them by size with no regard to
        # tile, stretching router-to-memory wires across the die. Die
        # kept at the RTLMP run's util-40 size for a clean comparison.
        "DIE_AREA": "0 0 6618.45 6618.45",
        "CORE_AREA": "1.14 1.4 6617.32 6616.4",
        "TNS_END_PERCENT": "100",
    },
)
