load("//:defs.bzl", "hightide_design")

hightide_design(
    name = "litedram",
    platform = "nangate45",
    # litedram_asic (2026-11): sdram_dq split into _i/_o/_oe at the top
    # boundary — no tristates, so SYNTH_HIERARCHICAL dropped and synth
    # runs flat. (See asap7/litedram/BUILD.bazel for the long form.)
    top = "litedram_asic",
    verilog_files = ["//designs/src/litedram:litedram_rtl"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
    },
    arguments = {
        # All 9 internal memories are 16-deep — synthesize as flop
        # arrays. No FakeRAM needed for litedram on nangate45.
        "CORE_UTILIZATION": "90",
        "PLACE_DENSITY": "0.92",
        "TNS_END_PERCENT": "100",
    },
)
