"""HighTide module — layered on top of bazel-orfs (pinned via submodule).

bazel-orfs lives at ./bazel-orfs as a git submodule.  Most Bazel
settings (dep versions, patches, OpenROAD/Qt commits) come from
bazel-orfs's own MODULE.bazel; we re-declare the overrides at the
root because git_override / archive_override / single_version_override
and register_toolchains are only honored in the root module, and we
reference patch files from the submodule (via //patches symlinks) to
avoid duplication.  Blocks below are copied verbatim from
bazel-orfs/MODULE.bazel with dev_dependency flags dropped (they must
be non-dev in the consuming root).

Keep these root-only overrides in sync with bazel-orfs/MODULE.bazel
whenever the submodule is bumped (current pin: 805ffd68).

ORFS itself is no longer overridden here: bazel-orfs's orfs_repositories
extension owns the ORFS fetch and its patches; the root passes the ORFS
commit via orfs.source() below, where HighTide also applies its own ORFS
patches (gt2n platform, no-rcx spef stub).

HighTide-specific additions on top:
  - orfs.source() ORFS patches: gt2n platform build plumbing + rcx stub
  - the slang yosys plugin now comes from @sv-elab via orfs.default()
    (the old in-repo yosys-slang plugin build is gone)
"""

module(
    name = "hightide",
    version = "0.0.1",
)

# --- bazel-orfs pinned via submodule ---
bazel_dep(name = "bazel-orfs")
local_path_override(
    module_name = "bazel-orfs",
    path = "bazel-orfs",
)

# --- Root-only overrides mirrored from bazel-orfs/MODULE.bazel ---
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "rules_cc", version = "0.2.22")

bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "abc", version = "0.68-yosyshq.bcr.1")

# Visible to .bazelrc's --@ncurses//:use_terminfo_data_target (abc and yosys ->
# readline -> ncurses), at the version the graph resolves anyway.  bazel-orfs
# declares this dev-only; the flag evaluates in the root context, so the
# consuming root needs it too.
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.14")

bazel_dep(name = "yosys", version = "0.68.bcr.2")

# Root-only, as every override. Each patch retires at the bump onto a BCR
# yosys that has its fix.
#
# 0001: write_xaiger2 wrote the white-box logic (holes) out of box order,
# so ABC's default &verify crashed on every abc_new run with two or more
# boxes, hidden as a warning. Fixed on yosys main after v0.69.
# 0002: abc_new took "-script" anywhere in its arguments, such as in a
# liberty path under OpenROAD-flow-scripts, for a given -script and
# dropped its default script. YosysHQ/yosys#6320, not fixed upstream.
single_version_override(
    module_name = "yosys",
    patch_strip = 1,
    patches = [
        "//patches:yosys-0001-aiger2-holes-output-order.patch",
        "//patches:yosys-0002-abc-new-script-option.patch",
    ],
)

# Tcl, for //fork: the fork/join extension is compiled against the same
# @tcl_lang the openroad module embeds (MVS keeps the two in lockstep), so
# the loadable .so always matches the interpreter that `load`s it. Non-dev:
# downstream roots build //fork:liborfsfork.so through orfs_run targets.
bazel_dep(name = "tcl_lang", version = "9.0.2.bcr.2")

# The slang frontend, sv-elab (formerly yosys-slang): the yosys plugin
# (slang.so), loaded via orfs.default(yosys_plugins=...) below since BCR
# yosys does not bundle it, and OpenROAD's syn, which compiles its sources.
# Non-dev: the orfs.default tag references @sv-elab, so the repo must stay
# visible even when bazel-orfs is consumed as a dependency (a dev dep is
# dropped for non-root modules). It also lets downstream roots reference
# the plugin label.
#
# From the BCR, at the release OpenROAD #12112 and #12055 move OpenROAD
# to. Until then OpenROAD asks for 2026-10-13, its third-party/sv-elab
# submodule behind a local_path_override that only its own root honours,
# and no such release exists; the version below answers every request.
# The plugin and OpenROAD's syn share this one frontend.
bazel_dep(name = "sv-elab", version = "2026-10-29")

single_version_override(
    module_name = "sv-elab",
    patch_strip = 1,
    patches = [
        # A redefined net (`output q; wire q, q;`, which slang accepts with
        # -Wredefinition) gets a wire of its own that takes the port wire's
        # name; with --keep-hierarchy the module loses the port, and
        # nangate45/ariane133 failed canonicalization ("does not have a port
        # named 'flush_ex_o'"). The redefinition now shares the wire name
        # lookup finds. Not upstreamed; retires at an sv-elab release that
        # carries it.
        "//patches:sv-elab-0001-redefinition-shares-wire.patch",
    ],
    version = "2026-10-29",
)

# OpenROAD's web viewer bundles npm packages with rules_js, which below
# 3.5.0 links a package's dependencies wrongly when the package store is
# in an external repository's sub-package (aspect-build/rules_js#2864):
# @openroad//src/web:third_party_licenses fails on a missing
# package.json whenever OpenROAD is not the root module. A floor, not a
# use: retires when OpenROAD itself asks for rules_js >= 3.5.0.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")

bazel_dep(name = "openroad")

archive_override(
    module_name = "openroad",
    integrity = "sha256-W4sbnCW2Rupf4geciFzDYYTc6m4tRh/1YuTwbGXnNZg=",
    # GitHub /archive/<sha>.tar.gz tarballs don't carry submodules,
    # so vendor src/sta (OpenSTA) and the other submodules from their own
    # GitHub auto-archives at the SHAs OpenROAD's .gitmodules pins
    # to.  sha256sum -c verifies each tarball since patch_cmds bytes
    # aren't covered by archive_override's integrity.  Regenerated
    # by bump.py on every commit bump; do not edit by hand.
    patch_cmds = [
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-src-sta-deeff1dc0603b19ef808a567edb6175bff72a642.tar.gz https://github.com/The-OpenROAD-Project/OpenSTA/archive/deeff1dc0603b19ef808a567edb6175bff72a642.tar.gz && echo 'e6e573102da6219772cf20a183051976305286cf01f5de85221a3637f2b403fb  .openroad-submodule-src-sta-deeff1dc0603b19ef808a567edb6175bff72a642.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-src-sta-deeff1dc0603b19ef808a567edb6175bff72a642.tar.gz --strip-components=1 -C src/sta && rm .openroad-submodule-src-sta-deeff1dc0603b19ef808a567edb6175bff72a642.tar.gz",
        # check_setup missed a register whose clock pin sees only the edge
        # it does not launch on (the clock network ignores transitions),
        # though no path through it was timed. Not upstreamed; retires at
        # a bump onto an OpenSTA that has it.
        # Extracted from //patches:0109-opensta-check-setup-launch-edge.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0109-opensta-check-setup-launch-edge.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0109-opensta-check-setup-launch-edge.patch.' && exit 1)",
        # Search asked, at every edge a set_max_delay state crossed,
        # whether the pin completes the -to, through the -to's id-ordered
        # sets: a third of write_timing_model on a register file under
        # ORFS's asap7 SDC (OpenROAD#11933). The -to objects are now hashed
        # and asked first. Not upstreamed; retires at a bump onto an
        # OpenSTA that has it.
        # Extracted from //patches:0145-opensta-path-delay-to-hashed.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0145-opensta-path-delay-to-hashed.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0145-opensta-path-delay-to-hashed.patch.' && exit 1)",
        # A thread cached only the tags it made, so every tag another
        # thread made took tag_lock_ at each lookup (OpenROAD#11999). A tag
        # found in the shared set now goes into the thread's cache too.
        # Not upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0146-opensta-tag-cache-found-tags.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0146-opensta-tag-cache-found-tags.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0146-opensta-tag-cache-found-tags.patch.' && exit 1)",
        # findTagGroup took tag_group_lock_ for every lookup
        # (OpenROAD#11999); each arrival-search thread now caches the tag
        # groups it finds. Not upstreamed; retires at a bump onto an
        # OpenSTA that has it.
        # Extracted from //patches:0147-opensta-tag-group-cache.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0147-opensta-tag-group-cache.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0147-opensta-tag-group-cache.patch.' && exit 1)",
        # Every vertex a -from filter reaches was inserted into an ordered
        # set under one lock (OpenROAD#11999); each arrival-search thread
        # now collects them and adds them after the visit. Not upstreamed;
        # retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0148-opensta-filtered-arrivals-per-thread.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0148-opensta-filtered-arrivals-per-thread.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0148-opensta-filtered-arrivals-per-thread.patch.' && exit 1)",
        # write_timing_model visited an input's path ends on the main
        # thread alone (OpenROAD#11999); they are now visited on every
        # thread and the margins merged by max. Not upstreamed; retires at
        # a bump onto an OpenSTA that has it.
        # Extracted from //patches:0149-opensta-timing-model-parallel-path-ends.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0149-opensta-timing-model-parallel-path-ends.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0149-opensta-timing-model-parallel-path-ends.patch.' && exit 1)",
        # Each filtered search ended with scans of every tag group, tag
        # and clock info for the filter's (OpenROAD#11999); the ones a
        # filter makes are now listed and only they are visited. Not
        # upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0150-opensta-filter-leftovers-listed.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0150-opensta-filter-leftovers-listed.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0150-opensta-filter-leftovers-listed.patch.' && exit 1)",
        # filteredEndpoints asked isEndpoint of every filtered vertex on
        # the main thread (OpenROAD#11999); it now asks on every thread
        # and gathers in the same order. Not upstreamed; retires at a
        # bump onto an OpenSTA that has it.
        # Extracted from //patches:0151-opensta-filtered-endpoints-parallel.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0151-opensta-filtered-endpoints-parallel.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0151-opensta-filtered-endpoints-parallel.patch.' && exit 1)",
        # One lock guarded every tag group lookup and creation
        # (OpenROAD#11999); the set is now 64 shards with a lock each,
        # tag_group_lock_ left guarding indices and tag_groups_. Not
        # upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0152-opensta-tag-group-shards.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0152-opensta-tag-group-shards.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0152-opensta-tag-group-shards.patch.' && exit 1)",
        # 0206: the clock-arrival search (ensureClkArrivals) stops at register
        # clock pins with more than one thread too; its per-thread visitor
        # copies dropped clks_only and searched the whole design. Upstream as
        # The-OpenROAD-Project/OpenSTA#462; retires at a //:bump onto an
        # OpenROAD whose OpenSTA has it.
        # Extracted from //patches:0206-opensta-clk-arrivals-copy-clks-only.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0206-opensta-clk-arrivals-copy-clks-only.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0206-opensta-clk-arrivals-copy-clks-only.patch.' && exit 1)",
        # 0210: a deleted net leaves the timing exceptions -through it, so
        # the flattened Top's crossing path group stays sound when repair
        # deletes one of its nets. Not upstreamed.
        # Extracted from //patches:0210-opensta-deleted-net-leaves-exceptions.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0210-opensta-deleted-net-leaves-exceptions.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0210-opensta-deleted-net-leaves-exceptions.patch.' && exit 1)",
    ],
    patch_strip = 1,
    patches = [
        # detailed_placement checks, before its search, that the cells can be
        # legalized at all within the displacement window: Hall's condition on
        # windows, demand of cells against the free sites they can reach. A
        # placement that fails it costs hours of diamond search and fails
        # anyway (82 minutes in a CTS stage whose clock buffers landed in
        # channels narrower than they needed). Not upstreamed; the upstream
        # pull request carries a gtest. Retires at a bump onto an OpenROAD
        # that has it.
        "//patches:0004-openroad-dpl-window-supply.patch",
        # 0140: the web viewer shows a busy cursor while a timing report it
        # was asked for is built (a slack-histogram bucket click, a bin
        # double-click, the timing widget's Update), as the Qt GUI does.
        # Not upstreamed; retires at a //:bump onto an OpenROAD whose web
        # viewer shows one.
        "//patches:0140-openroad-web-busy-cursor.patch",
        # 0142: widening a column of the web viewer's timing, hierarchy or
        # selection table widens the table instead of squeezing the other
        # columns, as the Qt GUI does. Not upstreamed; retires at a //:bump
        # onto an OpenROAD whose tables do.
        "//patches:0142-openroad-web-column-resize-widens-table.patch",
        # 0143: the web viewer's timing widget gets the Qt GUI's "Expand
        # clock": off by default, a path's clock network is one "clock
        # network delay" row. Not upstreamed; retires at a //:bump onto an
        # OpenROAD whose web timing widget has it.
        "//patches:0143-openroad-web-expand-clock.patch",
        # 0144: the web viewer's table columns are measured from their rows
        # until the user drags one (the timing table, first drawn empty,
        # opened cramped). Not upstreamed; retires with 0142.
        "//patches:0144-openroad-web-columns-measured-from-rows.patch",
        # 0156: generate_array -spec builds a register-file spec through
        # generate_ram_netlist and stops, naming the part, on any other
        # structure (ideas/structured-macros.md). Not upstreamed.
        "//patches:0156-openroad-ram-generate-array.patch",
        # 0159: generate_ram -w_port_words, the words each write port
        # writes: a word one port writes takes that port's data with no
        # data mux, and a port decodes only its words. Not upstreamed;
        # retires at a //:bump onto an OpenROAD that has it.
        "//patches:0159-openroad-ram-write-port-words.patch",
        # 0163: generate_ram -write_style mux buffers a word's write
        # enable and makes its hold per eight bits, so no net in a word
        # drives the whole word (a 32-bit word's hold inverter drove 32
