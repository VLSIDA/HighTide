        "//patches:0188-openroad-grt-backing-file.patch",
        # The 3D maze's work arrays allocated only while it runs.
        "//patches:0190-openroad-grt-maze3d-scoped.patch",
        # A backed grid written out and freed before the routes are converted,
        # where global route peaks (msync, then MADV_PAGEOUT).
        "//patches:0191-openroad-grt-backing-pageout.patch",
        # The blocked intervals freed once applied as capacity adjustments.
        "//patches:0192-openroad-grt-free-blocked-intervals.patch",
        # The 2D maze's work arrays allocated only for the overflow iterations.
        "//patches:0193-openroad-grt-maze2d-scoped.patch",
        # Each route finished (remaining guides, pad pins, merge) as FastRoute
        # hands it over, never every net's per-GCell segments at once. Not
