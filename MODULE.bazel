    strip_prefix = "OpenROAD-687848dd5e43b1e69972a1331fb4c83ce087e9c9",
    urls = ["https://github.com/The-OpenROAD-Project/OpenROAD/archive/687848dd5e43b1e69972a1331fb4c83ce087e9c9.tar.gz"],
)

# boost.icl: exclusive_less_than violates strict weak ordering (boostorg/icl#51);
# under libc++ this leaves phantom intervals after interval_set subtraction
# (#55), misplacing pad fillers. Upstream fix (#54) lands after boost 1.90.
single_version_override(
    module_name = "boost.icl",
    patch_strip = 1,
    patches = [
        "//patches:0001-refactor-interval-lookup-operations-icl-54.patch",
    ],
)

# rules_flex (transitive: openroad -> rules_flex): 0.3.1 uses the global
# `CcInfo` symbol, which Bazel 9 removed in favour of an explicit
# `load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")`. 0.4 adds that load
# and changes nothing else, so it is a no-op on Bazel 8.
#
# Not 0.4.1: it deletes flex/internal/toolchain_info.bzl, which is what puts
# `M4` (and the rest of m4_env) into `flex_toolchain.flex_env`. 0.4.1 sets M4
# inside its own flex_action instead, so a rule that drives flex from the
# toolchain directly gets an empty environment and flex dies looking for m4.
# @openroad's bazel/flex.bzl genlex is exactly such a rule -- it reads
# flex_env and rewrites the .runfiles/ paths in it -- so 0.4.1 breaks every
# OpenSTA lexer with a bare `flex failed: (Exit 1)`.
single_version_override(
    module_name = "rules_flex",
    version = "0.4",
)

# scip (transitive: openroad -> or-tools -> scip): or-tools asks for 9.2.3,
# whose BUILD overlay calls cc_library with no load(); Bazel 9 removed the
# autoloaded native rules. 10.0.3 has the load(), and is the version
# OpenROAD #12055 moves OpenROAD to.
single_version_override(
    module_name = "scip",
    version = "10.0.3",
)

# gawk (transitive: abc -> ncurses -> gawk; yosys -> gawk): its vendored
# gnulib headers shadow libc headers (stdio.h, error.h), which hermetic-llvm's
# explicit libc -isystem entries outrank (BCR #7642). The graph asks for no
# more than 5.3.2.bcr.3. 5.4.0.bcr.2 is the version OpenROAD's root pins
# for the same problem, and the floor OpenROAD #12112 and #12055 keep.
single_version_override(
    module_name = "gawk",
    version = "5.4.0.bcr.2",
)

# OpenROAD depends on rules_pycross, whose toolchain extension fails on Python
# 3.8 (transitively registered via or-tools -> pybind11_abseil, dropped
# from rules_python 2.0.0's MINOR_MAPPING). pycross.configure_environments
# is root-honored only, so the workaround must live here (mirrored from
# upstream OpenROAD's MODULE.bazel, which can't apply it from non-root).
single_version_override(
    module_name = "rules_pycross",
    patch_strip = 0,
    patches = ["//patches:rules_pycross_no_warning.patch"],
)

# pybind11_abseil (transitive: openroad -> or-tools): its pip extension
# names its hub "pypi", which rules_python now reserves:
#
#   WARNING: The PyPI hub name 'pypi' is reserved (module 'pybind11_abseil').
#   Please rename your hub, otherwise a future release will rename it to
#   'pybind11_abseil_pypi'.
#
# once per supported Python version, so five copies on every build.
# Upstream marks both of its python extensions dev_dependency; BCR's
# module-dot-bazel-dev-dependency.patch strips that marker off both. The
# toolchain one has to stay non-dev -- the cc targets we build need a
# Python toolchain -- but the pip one only feeds pybind11_abseil's own
# py_tests, which no consumer builds. So restore the marker on pip alone:
# a dev usage of a non-root module is ignored, the hub is never created,
# and the warning goes with it. Retires when BCR narrows its patch or
# upstream renames the hub.
single_version_override(
    module_name = "pybind11_abseil",
    patch_strip = 0,
    patches = ["//patches:pybind11_abseil_quiet.patch"],
    version = "202402.0",
)

# protoc-gen-validate: strip unused python/pip extensions whose unhashed
# requirements.txt causes rules_python to emit hundreds of DEBUG warnings.
single_version_override(
    module_name = "protoc-gen-validate",
    patch_strip = 0,
    patches = ["//patches:protoc_gen_validate_quiet.patch"],
    version = "1.0.4.bcr.2",
)

# grpc: strip unused python/pip extensions whose unhashed
# requirements.txt causes rules_python to emit hundreds of DEBUG warnings.
single_version_override(
    module_name = "grpc",
    patch_strip = 0,
    patches = ["//patches:grpc_quiet.patch"],
    version = "1.69.0",
)

# rules_jvm_external emits a DEBUG message when multiple modules contribute
# to the maven repo.
single_version_override(
    module_name = "rules_jvm_external",
    patch_strip = 0,
    patches = ["//patches:rules_jvm_external_quiet.patch"],
)

# dev_dependency: configure_environments above is root-honored only, so
# this pair does nothing for a downstream root, which must repeat it (as
# ORFS does). OpenROAD keeps pulling rules_pycross in.
bazel_dep(name = "rules_pycross", version = "0.8.3")

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross")

pycross.configure_environments(python_versions = ["3.13"])

# dev_dependency: this version-less bazel_dep only exists so the root-only
# git_override below has something to apply to. bazel-orfs builds no Qt
# (the GUI is the web viewer), but openroad's own bazel_dep(qt-bazel) has
# no BCR version and resolves only through the root's override.
# Downstream, the consumer's root override carries it, as README.md and
# docs/openroad.md require.
bazel_dep(name = "qt-bazel")

git_override(
    module_name = "qt-bazel",
    commit = "c3319f9e7735c67d47c7dfcc4a135bb91080f1a3",
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)

# Hermetic C++ toolchain for building OpenROAD (and yosys, gnumake) from
# source: the BCR "llvm" module (hermetic-llvm) — the same statically linked,
# zero-sysroot LLVM that OpenROAD itself registers. No host compiler and no
# dynamic libxml2 link, so the old toolchains_llvm + patched LLVM tarball +
# tools/xml-hack libxml2 stub are gone. dev_dependency: only bazel-orfs's own
# from-source tests build OpenROAD; downstream roots register their own (and
# OpenROAD's own registration is likewise dev-only, so it doesn't propagate).
#
# 0.8.18, not the newest: 0.8.19 moves the prebuilt compiler from LLVM
# 22.1.8 to 23.1.0, and a compiler major bump is a different change from
# picking up seven revisions of module fixes. 0.8.18 is the last release
# still on 22.1.8, so this is the toolchain we already build with plus
# whatever upstream fixed around it. The 23.1.0 move belongs in its own
# commit, with an OpenROAD build behind it.
bazel_dep(name = "llvm", version = "0.8.18")

# kepler-formal asks for llvm 0.8.24, which version resolution would take,
# moving every build to LLVM 23.1.0 behind this file's back. Held at the
# version above until that move gets its own commit; kepler-formal builds
# with it.
single_version_override(
    module_name = "llvm",
    version = "0.8.18",
)

register_toolchains(
    "@llvm//toolchain:all",
)

# --- kepler-formal, dev-only --------------------------------------------
#
# Logic equivalence checking (test/lec): the generated register files and
# memories against the RTL they replace. Nothing shipped uses it, and every
# lec_test is manual: it builds from source, too slow for CI. Taken at its
# main, never an old release (it is being fixed rapidly); its dependencies
# not yet on the Bazel Central Registry come from the registries .bazelrc
# lists, which reach only this repository's own builds, never a consumer.
# Bump the commit here and the registry URL in .bazelrc together.
# Adding kepler-formal must not move a version bazel-orfs already
# resolves: its graph asks for newer ones of these, and a rules_cc or zlib
# change rebuilds everything, OpenROAD included (fmt 12.2.0 does not even
# compile sv-lang 10.0.1, which kepler-formal's own naja uses). Held
# where bazel-orfs resolves them without it; drop a pin when bazel-orfs
# moves past it on its own.
single_version_override(
    module_name = "apple_support",
    version = "1.24.2",
)

single_version_override(
    module_name = "fmt",
    version = "12.1.0",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.22",
)

single_version_override(
    module_name = "yaml-cpp",
    version = "0.9.0",
)

single_version_override(
    module_name = "zlib",
    version = "1.3.1.bcr.8",
)

# 2.3.2, not 2.0.0: every module in the graph that depends on rules_python
# (protobuf, sv-lang, yosys, rules_pkg, ...) asks for 2.3.2, so MVS resolves
# there and a lower root pin only buys a --check_direct_dependencies warning
# on every invocation. Raise this to whatever `bazelisk mod explain
# rules_python` reports once a bump moves the graph again.
bazel_dep(
    name = "rules_python",
    version = "2.3.2",
)

# No implicit __init__.py in any py target of this repo: the behaviour is
# deprecated upstream (bazel-contrib/rules_python#2945) and warns on every
# fresh analysis. Root-honored only, so it covers this repo's own targets;
# the shipped public tools set legacy_create_init on the target instead, so
# downstream consumers running them stay quiet too.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")

rules_python_config.explicit_init_py(default = True)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)

python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# --- ORFS via the bazel-orfs extension (owns the fetch + patches) ---
orfs = use_extension("@bazel-orfs//:extension.bzl", "orfs_repositories")
orfs.source(
    commit = "3f8ab4ebeb3a886a88fc0774b176c77a18905718",
    integrity = "sha256-KY5/eb40I+yyoOuA0JEiI8xl0+YeeVoTpr2JZvBxuIg=",
    patches = [
        # No OpenRCX extraction rules for gt2n yet: stub the spef step so
        # the declared 6_final.spef output exists (rebased onto
        # final_outputs.tcl at this pin; was final_report.tcl).
        "//patches:orfs-no-rcx-spef-stub.patch",
    ],
    # HighTide's 4th platform.  ORFS upstream carries flow/platforms/gt2n
    # but bazel-orfs's generated flow/BUILD only emits orfs_pdk targets
    # for the platforms in its PDK_EXTS dict.  Consumer patch_cmds run
    # after the generators, so append gt2n there (exts per the platform's
    # file set; config.mk is named explicitly by the generated rule).
    patch_cmds = [
        """sed -i '/^PDK_EXTS = {/a \\    "gt2n": ["gds", "lef", "lib", "lyt", "lyp", "mk", "tcl", "v"],' flow/BUILD""",
    ],
)
orfs.default(
    # Expose the slang yosys plugin (from @sv-elab) via YOSYS_PLUGIN_PATH
    # so SYNTH_HDL_FRONTEND=slang works (bp_processor, vortex, floonoc,
    # snitch_cluster, ...).
    yosys_plugins = ["@sv-elab//src/yosys_plugin:slang.so"],
)
use_repo(orfs, "config")
use_repo(orfs, "gnumake")
use_repo(orfs, "orfs")
use_repo(orfs, "orfs_variable_metadata")

