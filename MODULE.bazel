        # retires at a //:bump onto an OpenROAD that has it.
        "//patches:0170-openroad-ram-pin-corners.patch",
        # Global route's memory (OpenROAD#12075), one concern per patch, the
        # guides unchanged in every one.
        # The 3D maze's search directions in a byte (4 -> 1 per GCell-layer).
        "//patches:0183-openroad-grt-direction-byte.patch",
        # The 3D maze's parents in int16 coordinates (12 -> 6 bytes).
        "//patches:0184-openroad-grt-parent3d-int16.patch",
        # The maze arrays sized to the grid rather than a square of at
        # least 1000 x 1000; cost_hvh_test_ sized along x as it is indexed.
        "//patches:0185-openroad-grt-maze-arrays-grid.patch",
        # A merged route gives back its unmerged per-GCell segments.
        "//patches:0186-openroad-grt-route-shrink.patch",
        # The maze heaps grow to the search frontier instead of a pointer per
