    sha256 = "fbb63239c7b4597bf78d0700bf4d19c2ec81944207b6b79f6b414f5cd0b62266",
    strip_prefix = "verilog-lfsr-c1f86d036745935f3812ec6ddc7821c70ef4c9de",
